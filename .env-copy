# ── 宿主机端口映射 ────────────────────────────────────────────────
# 修改这里可以避免与本机已有服务的端口冲突
POSTGRES_HOST_PORT=15432

# ── 照片目录（宿主机路径，只读挂载到容器 /photos）─────────────────
PHOTO_LIBRARY_PATH=/Users/unclema/Desktop/ai-lib

# ── 应用数据根目录（缩略图、数据库文件等）─────────────────────────
DATA_DIR=/Users/unclema/Desktop/ai-lib-data

# ── 缩略图目录（API 写入缩略图的路径）────────────────────────────
THUMBNAIL_PATH=${DATA_DIR}/thumbs

# ── 数据库 ────────────────────────────────────────────────────────
# 原生 macOS PostgreSQL 数据目录与二进制路径
POSTGRES_BIN_DIR=/opt/homebrew/opt/postgresql@17/bin
POSTGRES_DATA_DIR=${DATA_DIR}/postgres17

# 本地开发（uvicorn 直接运行）时连接 localhost + 宿主机端口
POSTGRES_PASSWORD=123456
DATABASE_URL=postgresql+psycopg://photo:${POSTGRES_PASSWORD}@localhost:15432/photo


# ── AI 模型（v0.2 起生效）────────────────────────────────────────
MODEL_ROOT=/Users/unclema/models

OPENAI_API_KEY=sk-local
OPENAI_BASE_URL=http://127.0.0.1:18082/v1
OPENAI_MODEL=MiniCPM-V-4.6
OPENAI_VISION_MODEL=MiniCPM-V-4.6


# ── Query Planner LLM（独立文本规划服务）──────────────────────────
# 用于搜索 Query Planner，不与视觉模型共用。
QUERY_PLANNER_SERVER=/Users/unclema/Workspace/llama.cpp/build/bin/llama-server
QUERY_PLANNER_MODEL=${MODEL_ROOT}/Qwen3-4B-Instruct-2507-Q4_0.gguf
QUERY_PLANNER_ALIAS=qwen3-4b-query-planner
QUERY_PLANNER_PORT=18084
QUERY_PLANNER_BASE_URL=http://127.0.0.1:18084/v1
QUERY_PLANNER_CTX=4096
QUERY_PLANNER_THREADS=6
QUERY_PLANNER_CACHE_RAM=0


# ── llama-server（本地推理引擎）────────────────────────────────────
# svc.sh 用这些变量启动/重启 llama-server，请根据实际路径修改
LLAMA_SERVER=/Users/unclema/Workspace/llama.cpp/build/bin/llama-server
LLAMA_MODEL=${MODEL_ROOT}/MiniCPM-V-4_6-Q4_K_M.gguf
LLAMA_MMPROJ=${MODEL_ROOT}/mmproj-model-f16.gguf
LLAMA_MODEL_ALIAS=MiniCPM-V-4.6

EMBED_SERVER=/Users/unclema/Workspace/llama.cpp/build/bin/llama-server
EMBED_MODEL=${MODEL_ROOT}/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_BASE_URL=http://127.0.0.1:8083/v1
EMBEDDING_MODEL=Qwen3-Embedding-0.6B

LLAMA_PORT=18082
LLAMA_CTX=2048
LLAMA_THREADS=2
# --media-path 允许 llama-server 读取本地文件（file:// URL），
# 设置为照片库的根目录即可（子目录也会被允许访问）
LLAMA_MEDIA_PATH=${PHOTO_LIBRARY_PATH}



# ── API 服务 ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
SVC_RELOAD=0

# ── 登录与 Session ─────────────────────────────────────────────
AUTH_ENABLED=1
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123456
AUTH_SESSION_SECRET=ai-photo-lib-local-session-secret-change-me
AUTH_SESSION_TIMEOUT_MINUTES=30
AUTH_COOKIE_SECURE=0

# ── Web 服务 ──────────────────────────────────────────────────────
WEB_PORT=18088

# ── 扫描 / AI Worker ──────────────────────────────────────────────
THUMBNAIL_SIZE=512
WORKER_CONCURRENCY=1
AI_MAX_RETRIES=3



# ── 地点反查 / reverse geocode（可选，默认关闭）──────────────────
# none: 不做地点反查，仅保留 GPS 坐标
# nominatim: 用 OpenStreetMap Nominatim 做 reverse geocode
LOCATION_RESOLVER_PROVIDER=nominatim
LOCATION_RESOLVER_ENDPOINT=https://nominatim.openstreetmap.org/reverse
LOCATION_RESOLVER_TIMEOUT_SECONDS=8
LOCATION_RESOLVER_USER_AGENT=ai-photo-lib/1.0
LOCATION_CACHE_ROUNDING_DECIMALS=4

# ── Face models / recognition ─────────────────────────────────────────────
FACE_DETECTOR_MODEL_PATH=${MODEL_ROOT}/face/yunet/face_detection_yunet_2023mar.onnx
FACE_EMBEDDING_MODEL_PATH=${MODEL_ROOT}/face/sface/face_recognition_sface_2021dec.onnx
FACE_RECOGNITION_ENABLED=true


