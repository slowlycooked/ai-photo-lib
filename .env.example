# ── 照片目录 ────────────────────────────────────────────────────
# 本地开发时指向你的照片目录，Docker 中只读挂载为 /photos
PHOTO_LIBRARY_PATH=/volume1/photo

# ── 缩略图目录 ───────────────────────────────────────────────────
THUMBNAIL_PATH=/data/thumbs

# ── 数据库连接（必填，无默认值）─────────────────────────────────
DATABASE_URL=postgresql+psycopg://photo:photo@localhost:5432/photo

# ── 数据存储根目录 ───────────────────────────────────────────────
# 用于存放缩略图、数据库文件等应用数据
DATA_DIR=/volume1/docker/ai-photo-lib

# ── 宿主机端口映射 ───────────────────────────────────────────────
# 若本机 5432 已被占用，修改这个值即可；容器内端口不变
POSTGRES_HOST_PORT=5432

# ── 数据库 ───────────────────────────────────────────────────────
# docker-compose 内部使用（api 容器通过 docker 网络访问 postgres:5432）
POSTGRES_PASSWORD=photo

# ── AI 模型（必填，无默认值）──────────────────────────────────────
# OpenAI 兼容接口（本地 LLM 服务，如 llama-server / vllm / xinference）
OPENAI_API_KEY=sk-local
OPENAI_BASE_URL=http://127.0.0.1:8082/v1
OPENAI_MODEL=MiniCPM-V-4.6
OPENAI_VISION_MODEL=MiniCPM-V-4.6
AI_VISION_MAX_TOKENS=1200
AI_VISION_TEMPERATURE=0.1

# ── Embedding 模型（可选，不配置则禁用语义搜索）──────────────────────
# 独立 embedding 服务，不与 vision llama 共享端口
# Docker 内地址固定为 http://llama-embed:8083/v1，本地调试填宿主机端口
EMBED_MODEL=/volume1/docker/ai-photo-lib/models/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_HOST_PORT=18083
EMBED_CTX=8192
EMBED_UB=8192
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=http://127.0.0.1:18083/v1
EMBEDDING_API_KEY=sk-local

# ── llama-server 模型文件路径（必填，无默认值）──────────────────────
# 本地 svc.sh 与 Docker Compose 统一使用同一组路径
LLAMA_MODEL=/volume1/docker/ai-photo-lib/models/MiniCPM-V-4_6-Q4_K_M.gguf
LLAMA_MMPROJ=/volume1/docker/ai-photo-lib/models/mmproj-model-f16.gguf
LLAMA_MODEL_ALIAS=MiniCPM-V-4.6

# llama-server prompt cache（独立图片任务建议关闭）
# 0 表示禁用；若要启用可设置更大值（单位 MiB）
LLAMA_CACHE_RAM=0

# ── API 服务 ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# 允许跨域的前端地址，逗号分隔；反向代理或自定义域名部署时修改此项
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8088

# ── Web 服务 ─────────────────────────────────────────────────────
WEB_PORT=8088

# ── 扫描 / AI Worker ─────────────────────────────────────────────
THUMBNAIL_SIZE=512
AI_MAX_RETRIES=3
