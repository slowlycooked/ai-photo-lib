# ── 机器角色 ────────────────────────────────────────────────────
# MacBook 开发机：dev
# Mac mini 运行机：prd（runtime 兼容）
DEPLOY_PROFILE=dev

# ── 照片库与缓存路径（每台机器单独配置为绝对路径）──────────────────
PHOTO_LIBRARY_PATH=/Users/yourname/Pictures/ai-photo-library
HOST_PHOTO_LIBRARY_PATH=/Users/yourname/Pictures/ai-photo-library
THUMBNAIL_PATH=/Users/yourname/Workspace/ai-photo-lib/.local/thumbs
POSTGRES_DATA_DIR=/Users/yourname/Workspace/ai-photo-lib/.local/postgres17

# ── PostgreSQL（macOS native，推荐 17 + pgvector）───────────────
POSTGRES_BIN_DIR=/opt/homebrew/opt/postgresql@17/bin
POSTGRES_USER=photo
POSTGRES_DB=photo
POSTGRES_PASSWORD=photo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://photo:photo@127.0.0.1:5432/photo

# ── API / Web 暴露方式 ─────────────────────────────────────────
# MacBook 开发机建议（如需仅本机访问可改回 127.0.0.1）:
#   API_HOST=0.0.0.0
#   WEB_HOST=0.0.0.0
#   WEB_MODE=dev
#
# Mac mini 运行机建议:
#   DEPLOY_PROFILE=prd
#   API_HOST=0.0.0.0
#   WEB_HOST=0.0.0.0
#   WEB_MODE=preview
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=0
WEB_HOST=0.0.0.0
WEB_PORT=8088
WEB_MODE=dev
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

# ── 登录与 Session ─────────────────────────────────────────────
AUTH_ENABLED=1
AUTH_USERNAME=admin
AUTH_PASSWORD=please-change-this-password
AUTH_SESSION_SECRET=please-change-this-random-secret
AUTH_SESSION_TIMEOUT_MINUTES=30
AUTH_COOKIE_SECURE=0

# ── 视觉模型 / llama-server ───────────────────────────────────
AI_VISION_RUNTIME=llama-server
LLAMA_SERVER=/opt/homebrew/bin/llama-server
LLAMA_MODEL=/Users/yourname/Models/MiniCPM-V-4_6-Q4_K_M.gguf
LLAMA_MMPROJ=/Users/yourname/Models/mmproj-model-f16.gguf
LLAMA_MODEL_ALIAS=MiniCPM-V-4.6
LLAMA_PORT=8082
LLAMA_CTX=8192
LLAMA_CACHE_RAM=0
LLAMA_MEDIA_PATH=/Users/yourname/Pictures/ai-photo-library

OPENAI_API_KEY=sk-local
OPENAI_BASE_URL=http://127.0.0.1:8082/v1
OPENAI_MODEL=MiniCPM-V-4.6
OPENAI_VISION_MODEL=MiniCPM-V-4.6
AI_VISION_MAX_TOKENS=1200
AI_VISION_TEMPERATURE=0.1

# ── Query Planner（独立文本规划服务）──────────────────────────
QUERY_PLANNER_SERVER=/opt/homebrew/bin/llama-server
QUERY_PLANNER_MODEL=/Users/yourname/Models/Qwen3-4B-Instruct-2507-Q4_0.gguf
QUERY_PLANNER_ALIAS=Qwen3-4B-Query-Planner
QUERY_PLANNER_PORT=8084
QUERY_PLANNER_BASE_URL=http://127.0.0.1:8084/v1
QUERY_PLANNER_CTX=4096
QUERY_PLANNER_THREADS=6
QUERY_PLANNER_CACHE_RAM=0

# ── Embedding 模型（可选）──────────────────────────────────────
EMBED_SERVER=/opt/homebrew/bin/llama-server
EMBED_MODEL=/Users/yourname/Models/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_PORT=8083
EMBED_CTX=8192
EMBED_UB=8192
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=http://127.0.0.1:8083/v1
EMBEDDING_API_KEY=sk-local
EMBEDDING_DIMENSION=1024

# ── 扫描 / Worker ──────────────────────────────────────────────
THUMBNAIL_SIZE=512
AI_MAX_RETRIES=3
AI_WORKER_CONCURRENCY=2

# Ollama + qwen3.8:27b 推荐覆盖：
# AI_VISION_RUNTIME=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen3.8:27b
# OPENAI_VISION_MODEL=qwen3.8:27b
# AI_WORKER_CONCURRENCY=1

# ── 地点反查 / reverse geocode（可选，默认关闭）──────────────────
# none: 不做地点反查，仅保留 GPS 坐标
# nominatim: 用 OpenStreetMap Nominatim 做 reverse geocode
LOCATION_RESOLVER_PROVIDER=none
LOCATION_RESOLVER_ENDPOINT=https://nominatim.openstreetmap.org/reverse
LOCATION_RESOLVER_TIMEOUT_SECONDS=8
LOCATION_RESOLVER_USER_AGENT=ai-photo-lib/1.0
LOCATION_CACHE_ROUNDING_DECIMALS=4
