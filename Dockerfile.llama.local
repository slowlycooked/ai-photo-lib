
FROM ubuntu:22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

ARG BUILD_JOBS=2

RUN apt-get update && apt-get install -y \
    cmake \
    build-essential \
    ca-certificates \
    findutils \
    grep \
    sed \
    && rm -rf /var/lib/apt/lists/*

COPY llama-src.tar.gz /tmp/llama-src.tar.gz

RUN set -eux; \
    mkdir -p /tmp/llama-unpack /src; \
    tar --warning=no-unknown-keyword -xzf /tmp/llama-src.tar.gz -C /tmp/llama-unpack; \
    SRC_DIR=""; \
    for d in /tmp/llama-unpack /tmp/llama-unpack/*; do \
      if [ -f "$d/CMakeLists.txt" ] \
         && grep -q "cmake_minimum_required" "$d/CMakeLists.txt" \
         && grep -q "project" "$d/CMakeLists.txt"; then \
        SRC_DIR="$d"; \
        break; \
      fi; \
    done; \
    test -n "$SRC_DIR"; \
    echo "Using llama.cpp source dir: $SRC_DIR"; \
    cp -a "$SRC_DIR"/. /src/; \
    find /src -name '._*' -delete; \
    find /src -name '.DS_Store' -delete; \
    test -f /src/CMakeLists.txt; \
    grep -n "project" /src/CMakeLists.txt | head; \
    echo "Check macOS metadata files:"; \
    find /src -name '._*' -o -name '.DS_Store'

WORKDIR /src

RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_NATIVE=OFF \
    -DGGML_LLAMAFILE=OFF \
    -DLLAMA_CURL=OFF \
    -DLLAMA_OPENSSL=OFF \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=ON \
    -DLLAMA_BUILD_TOOLS=ON \
    -DLLAMA_BUILD_SERVER=ON \
    -DLLAMA_BUILD_WEBUI=OFF \
    -DLLAMA_BUILD_UI=OFF \
    -DBUILD_SHARED_LIBS=OFF \
    -DGGML_SSE42=ON \
    -DGGML_BMI=OFF \
    -DGGML_BMI2=OFF \
    -DGGML_AVX=OFF \
    -DGGML_AVX2=OFF \
    -DGGML_AVX512=OFF \
    -DGGML_FMA=OFF \
    -DGGML_F16C=OFF \
    -DCMAKE_C_FLAGS="-march=silvermont -mtune=silvermont" \
    -DCMAKE_CXX_FLAGS="-march=silvermont -mtune=silvermont"

RUN cmake --build build --config Release -j${BUILD_JOBS} \
    && echo "Built binaries:" \
    && find build -type f -perm -111 | sort | sed -n '1,160p' \
    && SERVER_BIN="$(find build -type f -perm -111 \( -name 'llama-server' -o -name 'server' \) | head -n 1)" \
    && test -n "$SERVER_BIN" \
    && echo "Installing server binary: $SERVER_BIN" \
    && install -m 0755 "$SERVER_BIN" /usr/local/bin/llama-server

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/bin/llama-server /usr/local/bin/llama-server

EXPOSE 8082

ENTRYPOINT ["llama-server"]
